do {
    console.log("Even: " + k);
    k += 2;
} while (k <= 10);

// 4. Factorial of 5
let n = 5;
let factorial = 1;
let l = 1;
do {
    factorial *= l;
    l++;
} while (l <= n);
console.log("Factorial of 5: " + factorial);

// 5. Print characters of a string
let str = "Hello";
let m = 0;
do {
    console.log(str[m]);
    m++;
} while (m < str.length);

// 6. Countdown from 5 to 1
