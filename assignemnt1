*Loop statememnts:
While:
// 1. Print numbers from 1 to 10
console.log("1. Numbers from 1 to 10:");
let i = 5;
while (i <= 10) {
    console.log(i);
    i++;
}

// 2. Print even numbers up to 20
console.log("2. Even numbers up to 20:");
i = 2;
while (i <= 20) {
    console.log(i);
    i += 2;
}

// 3. Sum numbers from 1 to 50
console.log("3. Sum of numbers from 1 to 50:");
i = 1;
let sum = 0;
while (i <= 50) {
    sum += i;
    i++;
}
console.log("Sum:", sum);

// 4. Factorial of a number
console.log("4. Factorial of 5:");
let num = 5;
let factorial = 1;
i = 1;
while (i <= num) {
    factorial *= i;
    i++;
}
console.log("Factorial of 5 is: " + factorial);

// 5. Reverse a number
console.log("5. Reverse number 12345:");
num = 12345;
let reversed = 0;
while (num > 0) {
    let digit = num % 10;
    reversed = reversed * 10 + digit;
    num = Math.floor(num / 10);
}
console.log("Reversed number:", reversed);


// 6. Fibonacci series up to 60
console.log("6. Fibonacci series up to 60:");
let a = 0, b = 1;
while (a <= 60) {
    console.log(a);
    let next = a + b;
    a = b;
    b = next;
}


// 7. Guessing game
console.log("7. Guessing game (random guesses 1-10):");
let secretNumber = 4;
let guess = 0;
while (guess !== secretNumber) {
    guess = Math.floor(Math.random() * 10) + 1;
    console.log("Guessing:", guess);
}
console.log("Found the secret number:", secretNumber);

